          "name": "Upload ảnh lên Cloudinary (cần auth)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/upload/cloudinary",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Upload ảnh KHÔNG có token (phải trả về 401)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/upload/cloudinary",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "10. NOTIFICATIONS & MESSAGES",
      "item": [
        {
          "name": "Lấy thông báo của tôi",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_user}}" }]
          }
        },
        {
          "name": "Lấy ID Admin (để chat)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/messages/admin-id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_user}}" }]
          }
        },
        {
          "name": "Lấy lịch sử chat với Admin",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/messages/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_user}}" }]
          }
        }
      ]
    },
    {
      "name": "11. DASHBOARD - Thống kê Admin",
      "item": [
        {
          "name": "[ADMIN] Xem Dashboard tổng quan",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }]
          }
        }
      ]
    },
    {
      "name": "12. BẢO MẬT - Security Tests",
      "item": [
        {
          "name": "Truy cập Admin API không có token (→ 401)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Truy cập Admin API bằng token User (→ 403)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_user}}" }]
          }
        },
        {
          "name": "Đăng nhập sai mật khẩu (→ 401)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookstore.vn\",\n  \"password\": \"SaiMatKhau123\"\n}"
            }
          }
        },
        {
          "name": "Đặt hàng sách hết stock (→ 400)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_user}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
